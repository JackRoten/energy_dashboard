{
    "family": "react-app-task",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [ "FARGATE" ],
    "cpu": "256",
    "memory": "512",
    "executionRoleArn": "<EXECUTION_ROLE>",
    "taskRoleArn": "<TASK_ROLE>",
    "containerDefinitions": [
      {
        "name": "react-app",
        "image": "<IMAGE_PLACEHOLDER>",
        "essential": true,
        "portMappings": [
          {
            "containerPort": 8080,
            "protocol": "tcp"
          }
        ],
        "secrets": [
          {"name": "api_gateway_secret",
          "valueFrom": "<API_GATEWAY_ID>"}
        ]
      }
    ]
  }
  